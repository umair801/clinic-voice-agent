{
  "version": "1.0.1",
  "prompt_file": "prompts/system.md",
  "models": {
    "small": "claude-haiku-5-5",
    "large": "claude-sonnet-5-5"
  },
  "fallback_order": [
    "small",
    "large"
  ],
  "stt": {
    "provider": "deepgram",
    "model": "nova-3",
    "language": "multi"
  },
  "tts": {
    "provider": "elevenlabs",
    "model": "eleven_turbo_v2_5"
  },
  "turn": {
    "endpointing_min_delay": 0.4,
    "endpointing_max_delay": 2.0,
    "interruption_mode": "adaptive",
    "preemptive_generation": false,
    "min_interruption_words": 1
  },
  "silence": {
    "reprompt_after_s": 8,
    "max_reprompts": 2
  },
  "tool_budget_s": {
    "identify_patient": 4,
    "book_appointment": 6
  },
  "rollout": {
    "canary_percent": 0
  }
}